DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/crawler_db
SCHEDULE_CRON=0 3 * * *
USE_STEALTH=true
CONCURRENCY=5
REQUEST_DELAY=2

# 腾讯翻译君 API 配置 (用于新闻翻译)
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key

# AI 服务配置 (用于生成模型描述和优势)
# Agnes 2.5 Flash (主) - 推荐
AGNES_API_KEY=your_agnes_api_key
# GLM-4.7 Flash (备) - 备选
GLM_API_KEY=your_glm_api_key
